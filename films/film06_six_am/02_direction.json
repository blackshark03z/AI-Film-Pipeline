  "vision": {
    "tone": "Quiet, plain, close: two people seated across a diner booth after closing, the turn carried by looks and an envelope nobody touches, never by a speech.",
    "references": [
      "an empty diner at night seen at seated eye level, warm lamp over one booth against blue rain on the window",
      "a low-key confession drama played in pauses and glances"
    ]
  },
  "visual_rules": [
    {
      "rule": "Seated eye-level static camera, no dutch angles, no handheld shake.",
      "why": "The turn comes from Ruth's face and Sam's reaction, not from the camera."
    },
    {
      "rule": "Both stay seated in the booth for the whole film, and every single shows the high red booth back behind the head and the table edge in front.",
      "why": "film05 close singles at table height read as standing or seated by chance; the booth back and the table edge make the posture readable in every frame."
    },
    {
      "rule": "Keep Ruth screen-left and Sam screen-right in every shot of the booth.",
      "why": "The table stays the distance between them and the cut never flips who is where."
    },
    {
      "rule": "Nobody touches the envelope or the mug on screen.",
      "why": "Hands on small props are the least reliable thing the video model does; the envelope tells the story by lying still."
    },
    {
      "rule": "Hold on the listener after a line lands.",
      "why": "The drama is how each takes the other's words."
    }
