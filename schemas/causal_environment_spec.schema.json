{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAUSAL_ENVIRONMENT_SPEC v1 (QUALITY-V2-009)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment_id",
    "shot_scope",
    "gust_direction",
    "cloth_pressure",
    "hair_movement",
    "vegetation_movement",
    "body_lean_response",
    "effort_requirement",
    "forbidden_environment",
    "authority_sources",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "causal-environment-spec-v1"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^CE-[a-f0-9]{16}$"
    },
    "shot_scope": {
      "type": "string",
      "minLength": 1
    },
    "gust_direction": {
      "type": "string",
      "minLength": 1
    },
    "cloth_pressure": {
      "type": "string",
      "minLength": 1
    },
    "hair_movement": {
      "type": "string"
    },
    "vegetation_movement": {
      "type": "string"
    },
    "body_lean_response": {
      "type": "string",
      "minLength": 1
    },
    "effort_requirement": {
      "type": "string",
      "minLength": 1
    },
    "forbidden_environment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_sources": {
      "type": "object",
      "minProperties": 4
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
