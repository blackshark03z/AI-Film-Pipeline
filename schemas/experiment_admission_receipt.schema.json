{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperimentAdmissionReceipt v1 (QUALITY-V2-001 section 9)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "experiment_id",
    "target_quality_debt_ids",
    "canonical_baseline_sha256",
    "hypothesis",
    "variables_changed",
    "variables_held_constant",
    "max_generate_budget",
    "provider_route",
    "acceptance_criteria",
    "owner_review_surface",
    "rollback_plan",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "experiment-admission-receipt-v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^EXA-[a-f0-9]{16}$"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "description": "e.g. V2-002; admission is mandatory from V2-002 onward"
    },
    "target_quality_debt_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^QD-[0-9]{3}$"
      }
    },
    "canonical_baseline_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$",
      "description": "must equal the frozen QUALITY_V2_CANONICAL_BASELINE"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "variables_changed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "variables_held_constant": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_generate_budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50,
      "description": "finite, bounded Generate budget; unbounded budgets are refused by the admission gate"
    },
    "provider_route": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner_review_surface": {
      "type": "string",
      "minLength": 1
    },
    "rollback_plan": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
