{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EditManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edit_manifest_id",
    "project_id",
    "clips"
  ],
  "properties": {
    "edit_manifest_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "shot_id",
          "selected_take_id",
          "asset_id"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "shot_id": {
            "type": "string"
          },
          "selected_take_id": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "source_in_s": {
            "type": "number",
            "minimum": 0
          },
          "source_out_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "target_duration_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
