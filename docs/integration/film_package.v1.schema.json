{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoedit-v2/film_package.v1",
  "title": "film_package v1: picture-locked film hand-off from a producer to the post engine",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "film_id", "source", "files", "clock", "picture", "audio"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "film_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string"},
    "language": {"type": "string", "description": "BCP-47 primary dialogue language, e.g. en, vi"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "producer"],
      "properties": {
        "root": {"type": "string", "description": "Absolute folder; every files[].path resolves against it"},
        "producer": {"enum": ["afp", "muse", "handwritten_fixture", "other"]},
        "revision": {"type": "string", "description": "Producer git commit, if any"},
        "dirty": {"type": "boolean"},
        "supersedes": {"type": "string", "description": "package_id this package replaces (re-render)"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"type": "string", "description": "Relative to source.root; must not escape it"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "render_binding"],
      "properties": {
        "file_id": {"$ref": "#/$defs/id"},
        "edl_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "render_binding": {
          "enum": ["verified", "unverified"],
          "description": "verified = producer proved picture file was rendered from this lock"
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps_num", "fps_den", "duration_frames"],
      "properties": {
        "fps_num": {"type": "integer", "minimum": 1},
        "fps_den": {"type": "integer", "minimum": 1},
        "duration_frames": {"type": "integer", "minimum": 1},
        "audio_sample_rate": {"type": "integer", "minimum": 8000}
      }
    },
    "picture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "baked"],
      "properties": {
        "file_id": {"$ref": "#/$defs/id"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "baked": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grade", "cards", "subtitles"],
          "properties": {
            "grade": {"type": "string", "description": "none | <producer look id> | unknown"},
            "cards": {"type": "boolean", "description": "title/credit cards burned into picture"},
            "subtitles": {"type": "boolean"},
            "tags": {"type": "string", "description": "disclosure/watermark tags: none | <desc> | unknown"}
          }
        }
      }
    },
    "timeline": {
      "description": "L1+. Half-open [in_frame, out_frame) on the final picture clock, cards included",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "kind", "in_frame", "out_frame"],
        "properties": {
          "event_id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["TAKE", "CARD", "BLACK", "OTHER"]},
          "scene_id": {"$ref": "#/$defs/id"},
          "take_id": {"type": "string"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_in_frame": {"type": "integer", "minimum": 0},
          "in_frame": {"type": "integer", "minimum": 0},
          "out_frame": {"type": "integer", "minimum": 1}
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id"],
        "properties": {
          "scene_id": {"$ref": "#/$defs/id"},
          "intent": {"type": "string", "description": "story beat / mood, free text"},
          "location": {"type": "string"},
          "time_of_day": {"type": "string"},
          "characters": {"type": "array", "items": {"type": "string"}},
          "room_tone": {"type": "string", "description": "expected ambience, free text"}
        }
      }
    },
    "dialogue": {
      "description": "L1+. Cue rows; frames half-open on the picture clock",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cue_id", "in_frame", "out_frame", "text"],
        "properties": {
          "cue_id": {"$ref": "#/$defs/id"},
          "event_id": {"$ref": "#/$defs/id"},
          "speaker": {"type": "string"},
          "in_frame": {"type": "integer", "minimum": 0},
          "out_frame": {"type": "integer", "minimum": 1},
          "text": {"type": "string"},
          "timing_source": {"enum": ["script_estimate", "stt_aligned", "manual"]}
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "production_track"],
      "properties": {
        "level": {"enum": ["L0", "L1", "L2"]},
        "production_track": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file_id", "provenance"],
          "properties": {
            "file_id": {"$ref": "#/$defs/id"},
            "provenance": {"enum": ["native_composite", "isolated_dialogue", "full_mix"]}
          }
        },
        "layers": {
          "description": "Independent additive layers only. Never derived beds/mixes.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "file_id", "role", "provenance"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "file_id": {"$ref": "#/$defs/id"},
              "role": {"enum": ["music", "ambience", "sfx", "foley"]},
              "provenance": {"type": "string", "description": "e.g. afp_synthesized, catalog_asset, estimate"}
            }
          }
        }
      }
    },
    "assets": {
      "description": "Catalog assets the producer used (alternative representation of layers; never replay both)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file_id", "role"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "file_id": {"$ref": "#/$defs/id"},
          "role": {"enum": ["music", "ambience", "sfx", "foley"]},
          "rights_ref": {"$ref": "#/$defs/id"}
        }
      }
    },
    "references": {
      "description": "Role -> file id for producer reports kept for context (edl, cut_report, mix_report, rights, qc)",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/id"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"}
  }
}
