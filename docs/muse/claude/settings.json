{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stage_skills.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*muse_studio*)",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stage_skills.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
